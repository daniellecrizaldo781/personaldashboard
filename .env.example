# Personal Work Dashboard - Environment Variables

Copy this file to `.env` and fill in real values.

## === REQUIRED ONCE ===

# Session secret for signing JWT tokens (use a long random string)
SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars

# Admin password (for one-time setup; change after first login)
ADMIN_PASSWORD=change_this_to_a_strong_password

# === DATABASE ===
# SQLite is used by default and requires no extra config.
# To use a custom path, set DB_PATH:
DB_PATH=./data/dashboard.db

# === DOMAIN / HOSTING ===
# Your custom domain (used for PWA manifest and notification links)
BASE_URL=https://daniellecrizaldo.com

# === WEB PUSH (Phone push notifications) ===
# Generate a VAPID key pair: npx web-push generate-vapid-keys
# Or visit https://tools.reactpwa.site/vapid
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:danielle@daniellecrizaldo.com

# === SLACK INTEGRATION ===
# Create a Slack app at https://api.slack.com/apps
# See README for detailed setup steps.
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_REDIRECT_URI=https://daniellecrizaldo.com/auth/slack/callback
SLACK_TEAM_ID=your_workspace_team_id_here

# === NODE ENVIRONMENT ===
NODE_ENV=production
# Port for the server (default: 3000; set by hosting provider)
# PORT=3000